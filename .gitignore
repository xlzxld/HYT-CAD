# ============================================================================
# Git 排除文件 (.gitignore) - 热流道自动化 CAD 项目
# ============================================================================

# 1. 编译缓存与临时产物
__pycache__/
*.py[cod]
*$py.class
*.tmp
*.bak
*.bk1
*.bk2

# 2. AutoCAD 运行态与临时锁定文件
*.dwl
*.dwl2
*.sv$
*.ac$
*.dmp
*.err
*.log

# 2.1 CAD 运行产物(体检 C-02/C-03: 图纸产物不入库, 可由命令再生)
*.dwg
tools/*_out.dxf

# 2.2 脚本配置与对话框(用户定案 2026-09-09 不入库: ini/dcl 均为运行生成物
#     —— cx/flb/jrt 的 ini 与 dcl 由脚本启动/弹框时自动再生, mem ini 为
#     参数记忆; wx ini 仅被读取, 缺失时回退代码内置默认值。本机文件保留)
*.ini
*.dcl

# 3. 操作系统与文件管理器产物
Thumbs.db
ehthumbs.db
desktop.ini
.DS_Store

# 4. 编辑器与 IDE 配置
.vscode/
.idea/
*.swp
*~

# 5. 历史会话临时工作目录
.workbuddy/
.zcode/
scratch/
test/
temp/

# 演示记录器日志(临时工作材料, 不入库)
cad_demo_log.txt
